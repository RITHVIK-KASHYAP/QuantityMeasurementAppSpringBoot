pipeline {
    agent any

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'dev',
                url: 'https://github.com/RITHVIK-KASHYAP/QuantityMeasurementAppSpringBoot.git'
            }
        }

        stage('Build Artifact') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Copy Artifact') {
            steps {
                sh '''
                scp -o StrictHostKeyChecking=no \
                target/quanatitymeasurementapp-0.0.1-SNAPSHOT.jar \
                ubuntu@172.31.47.184:/app/target
                '''
            }
        }

        stage('Restart Application') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no \
                ubuntu@172.31.47.184 \
                "sudo systemctl restart quantityapp.service"
                '''
            }
        }
    }
}
